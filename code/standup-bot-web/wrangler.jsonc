{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "standup-bot",
	"main": "custom-worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "standup-db",
			// Local-only for now. Replace with the real ID from `wrangler d1 create standup-db` before deploying.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"STANDUP_CHANNEL_ID": "",
		"TEAM_TIMEZONE": "Asia/Kolkata"
	},
	"triggers": {
		// UTC. 09:30 IST reminder, 10:00 IST summary. Keep in sync with CRON_ROUTES in custom-worker.ts.
		"crons": ["0 4 * * MON-FRI", "30 4 * * MON-FRI"]
	},
	"observability": {
		"enabled": true
	}
}
